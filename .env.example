# Copy to .env and adjust. docker compose reads it automatically.
# Backend to run: spring | express | dotnet
BACKEND=spring
WEB_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-of-32-bytes
# Owner account used only by the migrate service
DB_ADMIN_PASSWORD=pulsewatch
# Restricted account the backends connect with (row-level security applies)
APP_DB_PASSWORD=pulsewatch_app
# Requests allowed per API key per window
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
# Days of check history to keep
RETENTION_DAYS=30
# Leave empty to turn tracing off
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
GRAFANA_ADMIN_PASSWORD=admin
